# ==============================================================================
# WEHOSTHERE — MODELO OFICIAL DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este ficheiro para .env.local e preencha com os seus dados reais:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. AUTENTICAÇÃO E SESSÕES (NextAuth.js & Google OAuth)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="https://wehosthere.com"
NEXTAUTH_SECRET="your-nextauth-secret-key-32-chars-min"

GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Chaves internas de assinatura de tokens (JWT e sessões de admin)
JWT_SECRET="your-jwt-secret-key"
ADMIN_SECRET="your-admin-secret-key"
SESSION_SECRET="your-session-secret-key"
APP_SECRET="your-app-secret-key"

# Password do Admin (hash bcrypt — NUNCA colocar a senha em texto puro)
# Gerar com: node -e "require('bcryptjs').hash('SUA_SENHA', 12).then(console.log)"
ADMIN_DEFAULT_PASSWORD_HASH=""
ADMIN_EMAIL="admin@wehosthere.com"
ADMIN_NOTIFICATION_EMAIL="suporte@wehosthere.com"

# ------------------------------------------------------------------------------
# 2. BASE DE DADOS (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Obrigatória para afiliados, histórico, e-mails externos e relatórios
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/wehosthere?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. URLs DO SITE E AMBIENTE (Next.js)
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="https://wehosthere.com"
NEXT_PUBLIC_APP_URL="https://wehosthere.com"
# Usar string vazia para URLs relativas na mesma origem
NEXT_PUBLIC_API_URL=""

# ------------------------------------------------------------------------------
# 4. E-MAIL CORPORATIVO E WEBMAIL (Migadu API, IMAP & SMTP)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="migadu"
MIGADU_API_URL="https://api.migadu.com/v1"
MIGADU_USERNAME="seu-email-migadu@dominio.com"
MIGADU_API_KEY="sua-chave-api-migadu"
MIGADU_IMAP_HOST="imap.migadu.com"
MIGADU_IMAP_PORT="993"
MIGADU_SMTP_HOST="smtp.migadu.com"
MIGADU_SMTP_PORT="465"

# Servidores padrão de fallback e proxy
DEFAULT_IMAP_SERVER="imap.migadu.com"
DEFAULT_SMTP_SERVER="smtp.migadu.com"
MAIL_PROXY_URL=""

# E-mails Transacionais do Sistema (Resend API)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
EMAIL_USER="noreply@wehosthere.com"

# ------------------------------------------------------------------------------
# 5. GATEWAYS DE PAGAMENTO
# ------------------------------------------------------------------------------
# 5.1 Kivora Payments (Moçambique & Cartões)
KIVORA_BASE_URL="https://www.kivorapayments.com"
KIVORA_API_KEY="sk_live_xxxxxxxxxxxxxxxx"
KIVORA_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# 5.2 Vodacom M-Pesa Moçambique (C2B Direto)
MPESA_ENV="sandbox" # 'sandbox' ou 'production'
MPESA_API_KEY="sua-api-key-mpesa"
MPESA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
MPESA_SERVICE_PROVIDER_CODE="171717"
MPESA_C2B_URL="https://api.sandbox.vm.co.mz:18352/ipg/v1x/c2bPayment/singleStage/"
MPESA_C2B_URL_PROD="https://api.vm.co.mz:18352/ipg/v1x/c2bPayment/singleStage/"

# 5.3 Stripe (Opcional - Cartões Internacionais)
STRIPE_PUBLIC_KEY="pk_test_your_key"
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ------------------------------------------------------------------------------
# 6. AUTOMAÇÃO DE HOSPEDAGEM & VPS (CyberPanel / cPanel / WHM)
# ------------------------------------------------------------------------------
VPS_PROVIDER="cyberpanel" # 'cyberpanel' | 'cpanel' | 'whm' | 'mock'
VPS_API_URL="https://seu-servidor-ip:8090/api/"
VPS_API_USER="admin"
VPS_API_PASSWORD="sua-senha-vps"
VPS_API_TOKEN=""

# ------------------------------------------------------------------------------
# 7. REVENDA E REGISTO DE DOMÍNIOS (Namecheap / ResellerClub / CIUEM)
# ------------------------------------------------------------------------------
RESELLER_PROVIDER="namecheap" # 'namecheap' | 'resellerclub' | 'mock'
RESELLER_API_USER="seu-usuario-revendedor"
RESELLER_API_KEY="sua-chave-api-revendedor"

# ------------------------------------------------------------------------------
# 8. INTELIGÊNCIA ARTIFICIAL (Site Builder & Assistente)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="sua-chave-gemini-api"
OPENAI_API_KEY="sk-proj-xxxxxxxx"

# ------------------------------------------------------------------------------
# 9. GESTÃO DE MÍDIA E IMAGENS (Cloudinary CDN)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="seu-api-secret"

# ------------------------------------------------------------------------------
# 10. NOTIFICAÇÕES WEB PUSH (VAPID)
# ------------------------------------------------------------------------------
# Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 11. TAREFAS AGENDADAS (CRON) E ALERTAS
# ------------------------------------------------------------------------------
CRON_SECRET="seu-token-cron-secreto"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ------------------------------------------------------------------------------
# 12. GOOGLE WORKSPACE RESELLER (Opcional)
# ------------------------------------------------------------------------------
GOOGLE_WORKSPACE_CLIENT_ID=""
GOOGLE_WORKSPACE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_REDIRECT_URI="https://wehosthere.com/auth/google/callback"
GOOGLE_WORKSPACE_RESELLER_ID=""
GOOGLE_WORKSPACE_ADMIN_EMAIL="admin@wehosthere.com"
GOOGLE_WORKSPACE_DOMAIN="wehosthere.com"
