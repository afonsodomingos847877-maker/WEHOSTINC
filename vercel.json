{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "wehosthere-backend": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install && npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "mail-proxy",
          "format": "url",
          "env": "MAIL_PROXY_URL"
        }
      ]
    },
    "mail-proxy": {
      "root": "mail-proxy",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "wehosthere-backend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/due-date-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/abandoned-carts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/affiliate-consistency",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/retry-failed-emails",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/site-quote-followup",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/reactivate-suspended",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/domain-upsell",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/stalled-tickets-alert",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/weekly-kpi-report",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/birthday-greetings",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ai-email-agent",
      "schedule": "0 7 * * *"
    }
  ]
}